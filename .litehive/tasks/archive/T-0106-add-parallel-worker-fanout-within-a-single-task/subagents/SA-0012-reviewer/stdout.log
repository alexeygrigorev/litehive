  worktree_path=worktree_path,\n                )\n            )\n            continue\n        if not worktree_dirty_entries:\n            continue\n        findings.append(\n            DirtyWorktreeFinding(\n                location_kind=\"task-worktree\",\n","exit_code":0,"status":"completed"}}
