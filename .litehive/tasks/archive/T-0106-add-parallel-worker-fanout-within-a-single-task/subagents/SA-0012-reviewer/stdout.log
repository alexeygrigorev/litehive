ty: {worker_key}\\n\"\n+        f\"- Worker slot: {ordinal}/{total}\\n\"\n+        f\"- Deterministic assignment: {assignment}\\n\"\n+        \"- Scope: implement only this assignment from the task plan while other SWE workers may be active.\\n\"\n+        \"- Reporting: summarize only your slice, including the files you changed and tests you ran.\\n\"\n+    )\n+\n+\n+def _aggregate_parallel_reports(\n+    task: TaskRecord,\n+    step: str,\n+    worker_reports: list[tuple[dict[str, str], StageReport]],\n+) -> StageReport:\n+    overall_verdict = min(\n+        (report.verdict for _, report in worker_reports),\n+        key=lambda verdict: _PARALLEL_VERDICT_ORDER[verdict],\n+    )\n+    if overall_verdict in {\"pass\", \"accept\"}:\n+        summary = f\"{step} fanout completed across {len(worker_reports)} workers\"\n+    else:\n+        failed = [\n+            f\"{spec['worker_key']}={report.verdict}\"\n+            for spec, report in worker_reports\n+            if report.verdict not in {\"pass\", \"accept\"}\n+        ]\n+        summary = f\"{step} fanout incomplete: {'; '.join(failed)}\"\n+\n+    feedback_parts: list[str] = []\n+    warnings: list[str] = []\n+    files_changed: list[str] = []\n+    follow_up_tasks = []\n+    tests = {\"added\": 0, \"passing\": 0}\n+    resource_limit_event = None\n+\n+    for spec, report in worker_reports:\n+        files_changed.extend(report.files_changed)\n+        follow_up_tasks.extend(report.follow_up_tasks)\n+        tests[\"added\"] += int(report.tests.get(\"added\", 0))\n+        tests[\"passing\"] += int(report.tests.get(\"passing\", 0))\n+        warnings.extend(\n+            f\"{spec['worker_key']}: {warning}\" for warning in report.warnings\n+        )\n+        if resource_limit_event is None and report.resource_limit_event is not None:\n+            resource_limit_event = report.resource_limit_event\n+        feedback_parts.append(\n+            \"\\n\".join(\n+                [\n+                    f\"[{spe