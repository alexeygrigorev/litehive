+                summary=f\"{worker_key} complete\",\n+                files_changed=[f\"{worker_key}.py\"],\n+            )\n+        return _completed_subagent_result(tmp_path, current_task.pipeline_status, engine_name=engine_name)\n+\n+    monkeypatch.setattr(\"litehive.runtime.SubagentManager.run\", fake_run)\n+    monkeypatch.setattr(\n+        \"litehive.runtime._commit_to_git_report\",\n+        lambda *args, **kwargs: StageReport(\n+            task_id=task.id,\n+            step=\"commit_to_git\",\n+            verdict=\"pass\",\n+            summary=\"commit skipped in test\",\n+        ),\n+    )\n+\n+    summary = run_task(tmp_path, task)\n+\n+    assert summary.result is not None\n+    assert summary.result.final_status == \"done\"\n+    implementing_calls = [worker for step, worker in calls if step == \"implementing\"]\n+    assert sorted(worker for worker in implementing_calls if worker is not None) == [\"worker-01\", \"worker-02\"]\n+    testing_index = next(index for index, item in enumerate(calls) if item[0] == \"testing\")\n+    assert testing_index >= 2\n+    assert sorted(finished_workers) == [\"worker-01\", \"worker-02\"]\n+    implementing_report = yaml.safe_load(\n+        (tmp_path / \".litehive\" / \"tasks\" / f\"{task.id}-{task.slug}\" / \"reports\" / \"implementing-001.yaml\").read_text(\n+            encoding=\"utf-8\"\n+        )\n+    )\n+    assert implementing_report[\"summary\"] == \"implementing fanout completed across 2 workers\"\n+    assert sorted(implementing_report[\"files_changed\"]) == [\"worker-01.py\", \"worker-02.py\"]\n+\n+def test_run_task_keeps_interrupted_fanout_task_recoverable(\n+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n+) -> None:\n+    ensure_workspace(tmp_path)\n+    task = create_task(\n+        tmp_path,\n+        title=\"Interrupted fanout\",\n+        acceptance_criteria=[\"interrupted workers remain recoverable\"],\n+        auto_commit=False,\n+    )\n+    task.pipeline_status = \"implementing\"\n+    task.plan = [\"First worker\", \"Second worker\"]\n+    save_task(tmp_path, task)\n+\n+    def fake_run(\n+        self,\n+        current_task,\n+        role,\n+        engine_name,\n+        prompt,\n+        model=None,\n+        max_turns=None,\n+        resume_session_id=None,\n+        worker_key=None,\n+        assignment=\"\",\n+    ):  # type: ignore[no-untyped-def]\n+        del self, role, prompt, model, max_turns, resume_session_id\n+        ref = None\n+        if current_task.pipeline_status == \"implementing\" and worker_key is not None:\n+            ref = SubagentRef(\n+                id=f\"SA-{worker_key}\",\n+                role=\"swe\",\n+                engine=engine_name,\n+                status=\"running\",\n+                path=f\"subagents/{worker_key}-swe\",\n+                worker_key=worker_key,\n+                assignment=assignment,\n+            )\n+            if all(existing.id != ref.id for existing in current_task.subagents):\n+                current_task.subagents.append(ref)\n+            tasks_module._upsert_runtime_subagent_state(\n+                current_task,\n+                RuntimeSubagentState(\n+                    id=ref.id,\n+                    role=ref.role,\n+                    engine=ref.engine,\n+                    status=\"running\",\n+                    path=ref.path,\n+                    worker_key=ref.worker_key,\n+                    assignment=ref.assignment,\n+                    started_at=\"2026-04-04T10:00:00+00:00\",\n+                    updated_at=\"2026-04-04T10:00:01+00:00\",\n+                ),\n+            )\n+            tasks_module._refresh_runtime_subagent_views(current_task)\n+        if current_task.pipeline_status == \"implementing\" and worker_key == \"worker-02\":\n+            assert ref is not None\n+            ref.status = \"interrupted\"\n+            tasks_module._upsert_runtime_subagent_state(\n+                current_task,\n+                RuntimeSubagentState(\n+                    id=ref.id,\n+                    role=ref.role,\n+                    engine=ref.engine,\n+                    status=\"interrupted\",\n+                    path=ref.path,\n+                    worker_key=ref.worker_key,\n+                    assignment=ref.assignment,\n+                    started_at=\"2026-04-04T10:00:00+00:00\",\n+                    updated_at=\"2026-04-04T10:00:02+00:00\",\n+                    completed_at=\"2026-04-04T10:00:02+00:00\",\n+                    exit_code=130,\n+                    transcript_snippet=\"Execution interrupted by user\",\n+                    interruption_reason=\"execution interrupted\",\n+                ),\n+            )\n+            tasks_module._refresh_runtime_subagent_views(current_task)\n+            return _interrupted_subagent_result(tmp_path, \"implementing\", engine_name=engine_name)\n+        if current_task.pipeline_status == \"implementing\":\n+            assert ref is not None\n+            ref.status = \"completed\"\n+            tasks_module._upsert_runtime_subagent_state(\n+                current_task,\n+                RuntimeSubagentState(\n+                    id=ref.id,\n+                    role=ref.role,\n+                    engine=ref.engine,\n+                    status=\"completed\",\n+                    path=ref.path,\n+                    worker_key=ref.worker_key,\n+                    assignment=ref.assignment,\n+                    started_at=\"2026-04-04T10:00:00+00:00\",\n+                    updated_at=\"2026-04-04T10:00:02+00:00\",\n+                    completed_at=\"2026-04-04T10:00:02+00:00\",\n+                    exit_code=0,\n+                    transcript_snippet=f\"{worker_key} complete\",\n+                ),\n+            )\n+            tasks_module._refresh_runtime_subagent_views(current_task)\n+            return _stage_subagent_result(\n+                tmp_path,\n+                \"implementing\",\n+                engine_name=engine_name,\n+                summary=f\"{worker_key} complete\",\n+            )\n+        return _completed_subagent_result(tmp_path, current_task.pipeline_status, engine_name=engine_name)\n+\n+    monkeypatch.setattr(\"litehive.runtime.SubagentManager.run\", fake_run)\n+\n+    summary = run_task(tmp_path, task)\n+\n+    assert summary.result is not None\n+    assert summary.result.final_status == \"interrupted\"\n+    refreshed = require_task(tmp_path, task.id)\n+    assert refreshed.status == \"interrupted\"\n+    assert refreshed.pipeline_status == \"implementing\"\n+    assert {state.status for state in refreshed.runtime.subagent_states} >= {\"completed\", \"interrupted\"}\n+    assert refreshed.runtime.last_subagent is not None\n+    assert refreshed.runtime.last_subagent.status == \"interrupted\"\n+\n def test_runner_does_not_override_qa_verdict(tmp_path: Path) -> None:\n     \"\"\"QA verdict is final and the runner lets testing pass advance normally.\"\"\"\n     ensure_workspace(tmp_path, LitehiveConfig(default_retry_limit=3))\ndiff --git a/tests/test_tasks_and_subagents.py b/tests/test_tasks_and_subagents.py\nindex a92f6bd..9e4a178 100644\n--- a/tests/test_tasks_and_subagents.py\n+++ b/tests/test_tasks_and_subagents.py\n@@ -696,6 +696,101 @@ def test_subagent_artifacts_update_live_during_streaming_execution(\n     assert refreshed.runtime.last_subagent is not None\n     assert refreshed.runtime.last_subagent.pid == 5151\n \n+def test_subagent_manager_persists_multiple_live_worker_states(\n+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n+) -> None:\n+    ensure_workspace(tmp_path)\n+    task = create_task(tmp_path, title=\"Persist parallel worker state\")\n+    manager = SubagentManager(tmp_path)\n+    release = threading.Event()\n+    pid_by_prompt = {\"worker-01\": 7101, \"worker-02\": 7102}\n+\n+    class FakeEngine:\n+        name = \"codex\"\n+        binary = \"codex\"\n+\n+        def is_available(self) -> bool:\n+            return True\n+\n+        def run(\n+            self,\n+            prompt: str,\n+            cwd: Path,\n+            model: str | None = None,\n+            *,\n+            max_turns: int | None = None,\n+            on_started=None,\n+        ) -> CLIExecutionResult:\n+            del cwd, model, max_turns\n+            pid = pid_by_prompt[prompt]\n+            if on_started is not None:\n+                on_started(pid)\n+            release.wait(timeout=5)\n+            return CLIExecutionResult(\n+                adapter=\"codex\",\n+                argv=(\"codex\", \"exec\"),\n+                cwd=tmp_path,\n+                exit_code=0,\n+                stdout=(\n+                    \"VERDICT: PASS\\n\"\n+                    f\"SUMMARY: {prompt} complete\\n\"\n+                    \"FILES_CHANGED:\\n\"\n+                    f\"- {prompt}.py\\n\"\n+                ),\n+                stderr=\"\",\n+                pid=pid,\n+            )\n+\n+        def render_transcript(self, execution: CLIExecutionResult) -> str:\n+            return execution.transcript\n+\n+    monkeypatch.setattr(\"litehive.subagents.get_engine\", lambda _: FakeEngine())\n+\n+    threads = [\n+        threading.Thread(\n+            target=manager.run,\n+            kwargs={\n+                \"task\": task,\n+                \"role\": \"swe\",\n+                \"engine_name\": \"codex\",\n+                \"prompt\": worker_key,\n+                \"worker_key\": worker_key,\n+                \"assignment\": f\"Implement {worker_key}\",\n+            },\n+        )\n+        for worker_key in (\"worker-01\", \"worker-02\")\n+    ]\n+    for thread in threads:\n+        thread.start()\n+\n+    deadline = time.time() + 5\n+    while time.time() < deadline:\n+        refreshed = get_task(tmp_path, task.id)\n+        assert refreshed is not None\n+        running = [\n+            state for state in refreshed.runtime.subagent_states\n+            if state.status == \"running\"\n+        ]\n+        if len(running) == 2 and {state.pid for state in running} == {7101, 7102}:\n+            break\n+        time.sleep(0.02)\n+    else:\n+        raise AssertionError(\"timed out waiting for both worker states\")\n+\n+    refreshed = get_task(tmp_path, task.id)\n+    assert refreshed is not None\n+    assert {state.worker_key for state in refreshed.runtime.subagent_states} == {\"worker-01\", \"worker-02\"}\n+    assert {state.pid for state in refreshed.runtime.subagent_states if state.status == \"running\"} == {7101, 7102}\n+    assert refreshed.runtime.active_subagent is not None\n+    for ref in refreshed.subagents:\n+        session = yaml.safe_load((task_dir(tmp_path, refreshed) / ref.path / \"session.yaml\").read_text(encoding=\"utf-8\"))\n+        assert session[\"worker_key\"] in {\"worker-01\", \"worker-02\"}\n+        assert session[\"assignment\"].startswith(\"Implement worker-\")\n+    release.set()\n+    for thread in threads:\n+        thread.join(timeout=5)\n+        assert not thread.is_alive()\n+\n def test_subagent_manager_records_copilot_quota_monitoring_during_live_updates(\n     tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n ) -> None:\n","exit_code":0,"status":"completed"}}
