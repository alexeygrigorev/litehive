nings=warnings,\n+        resource_limit_event=resource_limit_event,\n+    )\n \n \n def resolve_next_task(root: Path) -> TaskRecord | None:\n@@ -1438,6 +1531,7 @@ def build_executor(\n         execution_events: list[str] = []\n         engines = _engine_attempt_order(next_stage_engine_names, config.engine_fallbacks)\n         limit_trigger_reason: str | None = None\n+        worker_specs = _implementing_worker_specs(current_task) if step == \"implementing\" else []\n \n         for index, engine_name in enumerate(engines):\n             budget_reason = budget_ledger.block_reason(engine_name)\n@@ -1471,6 +1565,89 @@ def build_executor(\n \n             budget_ledger.record(engine_name)\n             model_name = resolve_model(task, config, engine_name=engine_name, model_override=model_override)\n+            if worker_specs:\n+                role_name = _role_for_step(step, current_task)\n+                base_prompt = stage_prompt(\n+                    current_task,\n+                    step,\n+                    workspace_context=workspace_context,\n+                    process_profile=config.process_profile,\n+                    role_name=role_name,\n+                    config=config,\n+                    root=root,\n+                )\n+                worker_results: list[tuple[dict[str, str], object]] = []\n+                with ThreadPoolExecutor(max_workers=len(worker_specs)) as pool:\n+                    futures = [\n+                        (\n+                            spec,\n+                            pool.submit(\n+                                subagents.run,\n+                                current_task,\n+                                role=role_name,\n+                                engine_name=engine_name,\n+                                prompt=_parallel_worker_prompt(\n+                                    base_prompt,\n+                                    worker_key=spec[\"worker_key\"],\n+                                    assi