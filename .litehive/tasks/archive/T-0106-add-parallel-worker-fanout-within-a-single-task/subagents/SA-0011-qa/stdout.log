h: Path, capsys: pytest.CaptureFixture[str]\n ) -> None:\ndiff --git a/tests/test_runner_workflow.py b/tests/test_runner_workflow.py\nindex 03cb949..31dd3e7 100644\n--- a/tests/test_runner_workflow.py\n+++ b/tests/test_runner_workflow.py\n@@ -112,6 +112,198 @@ def test_runner_requeues_task_after_testing_rejection(tmp_path: Path) -> None:\n     assert task.runtime.retry_limit == 3\n     assert task.runtime.retry_source == \"global\"\n \n+def test_run_task_fans_out_parallel_workers_within_implementing_stage(\n+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n+) -> None:\n+    ensure_workspace(tmp_path)\n+    task = create_task(\n+        tmp_path,\n+        title=\"Parallel implementation\",\n+        acceptance_criteria=[\"workers complete before testing starts\"],\n+        auto_commit=False,\n+    )\n+    task.pipeline_status = \"implementing\"\n+    task.plan = [\"Implement API surface\", \"Implement CLI wiring\"]\n+    save_task(tmp_path, task)\n+\n+    calls: list[tuple[str, str | None]] = []\n+    finished_workers: list[str] = []\n+    barrier = threading.Barrier(2)\n+\n+    def fake_run(\n+        self,\n+        current_task,\n+        role,\n+        engine_name,\n+        prompt,\n+        model=None,\n+        max_turns=None,\n+        resume_session_id=None,\n+        worker_key=None,\n+        assignment=\"\",\n+    ):  # type: ignore[no-untyped-def]\n+        del self, role, prompt, model, max_turns, resume_session_id, assignment\n+        calls.append((current_task.pipeline_status, worker_key))\n+        if current_task.pipeline_status == \"implementing\" and worker_key is not None:\n+            barrier.wait(timeout=5)\n+            finished_workers.append(worker_key)\n+            return _stage_subagent_result(\n+                tmp_path,\n+                \"implementing\",\n+                engine_name=engine_name,\n+                summary=f\"{worker_key} complete\",\n+                files_changed=[f\"{worker_key}.py\"],\n+            )\n+    