{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '100,330p' tests/test_runner_workflow.py\"","aggregated_output":"        verdict = \"fail\" if step == \"testing\" else \"pass\"\n        return StageReport(task_id=task.id, step=step, verdict=verdict, summary=f\"{step} {verdict}\")\n\n    runner = TaskExecutionRunner(tmp_path, executor, max_retries=3)\n    result = runner.run(task)\n\n    assert result.final_status == \"queued\"\n    task = get_task(tmp_path, task.id)\n    assert task is not None\n    assert task.status == \"queued\"\n    assert task.pipeline_status == \"implementing\"\n    assert task.runtime.retry_count == 1\n    assert task.runtime.retry_limit == 3\n    assert task.runtime.retry_source == \"global\"\n\ndef test_run_task_fans_out_parallel_workers_within_implementing_stage(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    ensure_workspace(tmp_path)\n    task = create_task(\n        tmp_path,\n        title=\"Parallel implementation\",\n        acceptance_criteria=[\"workers complete before testing starts\"],\n        auto_commit=False,\n    )\n    task.pipeline_status = \"implementing\"\n    task.plan = [\"Implement API surface\", \"Implement CLI wiring\"]\n    save_task(tmp_path, task)\n\n    calls: list[tuple[str, str | None]] = []\n    finished_workers: list[str] = []\n    barrier = threading.Barrier(2)\n\n    def fake_run(\n        self,\n        current_task,\n        role,\n        engine_name,\n        prompt,\n        model=None,\n        max_turns=None,\n        resume_session_id=None,\n        worker_key=None,\n        assignment=\"\",\n    ):  # type: ignore[no-untyped-def]\n        del self, role, prompt, model, max_turns, resume_session_id, assignment\n        calls.append((current_task.pipeline_status, worker_key))\n        if current_task.pipeline_status == \"implementing\" and worker_key is not None:\n            barrier.wait(timeout=5)\n            finished_workers.append(worker_key)\n            return _stage_subagent_result(\n                tmp_path,\n                \"implementing\",\n                engine_name=engine_name,\n                summary=f\"{worker_key} complete\",\n                files_changed=[f\"{worker_key}.py\"],\n            )\n        return _completed_subagent_result(tmp_path, current_task.pipeline_status, engine_name=engine_name)\n\n    monkeypatch.setattr(\"litehive.runtime.SubagentManager.run\", fake_run)\n    monkeypatch.setattr(\n        \"litehive.runtime._commit_to_git_report\",\n        lambda *args, **kwargs: StageReport(\n            task_id=task.id,\n            step=\"commit_to_git\",\n            verdict=\"pass\",\n            summary=\"commit skipped in test\",\n        ),\n    )\n\n    summary = run_task(tmp_path, task)\n\n    assert summary.result is not None\n    assert summary.result.final_status == \"done\"\n    implementing_calls = [worker for step, worker in calls if step == \"implementing\"]\n    assert sorted(worker for worker in implementing_calls if worker is not None) == [\"worker-01\", \"worker-02\"]\n    testing_index = next(index for index, item in enumerate(calls) if item[0] == \"testing\")\n    assert testing_index >= 2\n    assert sorted(finished_workers) == [\"worker-01\", \"worker-02\"]\n    implementing_report = yaml.safe_load(\n        (tmp_path / \".litehive\" / \"tasks\" / f\"{task.id}-{task.slug}\" / \"reports\" / \"implementing-001.yaml\").read_text(\n            encoding=\"utf-8\"\n        )\n    )\n    assert implementing_report[\"summary\"] == \"implementing fanout completed across 2 workers\"\n    assert sorted(implementing_report[\"files_changed\"]) == [\"worker-01.py\", \"worker-02.py\"]\n\ndef test_run_task_keeps_interrupted_fanout_task_recoverable(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    ensure_workspace(tmp_path)\n    task = create_task(\n        tmp_path,\n        title=\"Interrupted fanout\",\n        acceptance_criteria=[\"interrupted workers remain recoverable\"],\n        auto_commit=False,\n    )\n    task.pipeline_status = \"implementing\"\n    task.plan = [\"First worker\", \"Second worker\"]\n    save_task(tmp_path, task)\n\n    def fake_run(\n        self,\n        current_task,\n        role,\n        engine_name,\n        prompt,\n        model=None,\n        max_turns=None,\n        resume_session_id=None,\n        worker_key=None,\n        assignment=\"\",\n    ):  # type: ignore[no-untyped-def]\n        del self, role, prompt, model, max_turns, resume_session_id\n        ref = None\n        if current_task.pipeline_status == \"implementing\" and worker_key is not None:\n            ref = SubagentRef(\n                id=f\"SA-{worker_key}\",\n                role=\"swe\",\n                engine=engine_name,\n                status=\"running\",\n                path=f\"subagents/{worker_key}-swe\",\n                worker_key=worker_key,\n                assignment=assignment,\n            )\n            if all(existing.id != ref.id for existing in current_task.subagents):\n                current_task.subagents.append(ref)\n            tasks_module._upsert_runtime_subagent_state(\n                current_task,\n                RuntimeSubagentState(\n                    id=ref.id,\n                    role=ref.role,\n                    engine=ref.engine,\n                    status=\"running\",\n                    path=ref.path,\n                    worker_key=ref.worker_key,\n                    assignment=ref.assignment,\n                    started_at=\"2026-04-04T10:00:00+00:00\",\n                    updated_at=\"2026-04-04T10:00:01+00:00\",\n                ),\n            )\n            tasks_module._refresh_runtime_subagent_views(current_task)\n        if current_task.pipeline_status == \"implementing\" and worker_key == \"worker-02\":\n            assert ref is not None\n            ref.status = \"interrupted\"\n            tasks_module._upsert_runtime_subagent_state(\n                current_task,\n                RuntimeSubagentState(\n                    id=ref.id,\n                    role=ref.role,\n                    engine=ref.engine,\n                    status=\"interrupted\",\n                    path=ref.path,\n                    worker_key=ref.worker_key,\n                    assignment=ref.assignment,\n                    started_at=\"2026-04-04T10:00:00+00:00\",\n                    updated_at=\"2026-04-04T10:00:02+00:00\",\n                    completed_at=\"2026-04-04T10:00:02+00:00\",\n                    exit_code=130,\n                    transcript_snippet=\"Execution interrupted by user\",\n                    interruption_reason=\"execution interrupted\",\n                ),\n            )\n            tasks_module._refresh_runtime_subagent_views(current_task)\n            return _interrupted_subagent_result(tmp_path, \"implementing\", engine_name=engine_name)\n        if current_task.pipeline_status == \"implementing\":\n            assert ref is not None\n            ref.status = \"completed\"\n            tasks_module._upsert_runtime_subagent_state(\n                current_task,\n                RuntimeSubagentState(\n                    id=ref.id,\n                    role=ref.role,\n                    engine=ref.engine,\n                    status=\"completed\",\n                    path=ref.path,\n                    worker_key=ref.worker_key,\n                    assignment=ref.assignment,\n                    started_at=\"2026-04-04T10:00:00+00:00\",\n                    updated_at=\"2026-04-04T10:00:02+00:00\",\n                    completed_at=\"2026-04-04T10:00:02+00:00\",\n                    exit_code=0,\n                    transcript_snippet=f\"{worker_key} complete\",\n                ),\n            )\n            tasks_module._refresh_runtime_subagent_views(current_task)\n            return _stage_subagent_result(\n                tmp_path,\n                \"implementing\",\n                engine_name=engine_name,\n                summary=f\"{worker_key} complete\",\n            )\n        return _completed_subagent_result(tmp_path, current_task.pipeline_status, engine_name=engine_name)\n\n    monkeypatch.setattr(\"litehive.runtime.SubagentManager.run\", fake_run)\n\n    summary = run_task(tmp_path, task)\n\n    assert summary.result is not None\n    assert summary.result.final_status == \"interrupted\"\n    refreshed = require_task(tmp_path, task.id)\n    assert refreshed.status == \"interrupted\"\n    assert refreshed.pipeline_status == \"implementing\"\n    assert {state.status for state in refreshed.runtime.subagent_states} >= {\"completed\", \"interrupted\"}\n    assert refreshed.runtime.last_subagent is not None\n    assert refreshed.runtime.last_subagent.status == \"interrupted\"\n\ndef test_runner_does_not_override_qa_verdict(tmp_path: Path) -> None:\n    \"\"\"QA verdict is final and the runner lets testing pass advance normally.\"\"\"\n    ensure_workspace(tmp_path, LitehiveConfig(default_retry_limit=3))\n    task = create_task(\n        tmp_path,\n        title=\"Enforce workflow verification\",\n        goal=\"Prove control-plane lifecycle behavior through the real CLI\",\n        acceptance_criteria=[\n            \"commit_to_git succeeds and records the final checkpoint commit\",\n        ],\n        auto_commit=False,\n    )\n    task.pipeline_status = \"testing\"\n    save_task(tmp_path, task)\n\n    def executor(current_task, step):  # type: ignore[no-untyped-def]\n        return StageReport(\n            task_id=current_task.id,\n            step=step,\n            verdict=\"pass\",\n            summary=f\"{step} ok\",\n            feedback=\"Verified with pytest.\",\n        )\n\n","exit_code":0,"status":"completed"}}
