atus,\n        path=ref.path,\n        worker_key=ref.worker_key,\n        assignment=ref.assignment,\n        sandboxed=ref.sandboxed,\n        sandbox_summary=ref.sandbox_summary,\n        started_at=now,\n        updated_at=now,\n        continuation=None,\n        ),\n    )\n    _refresh_runtime_subagent_views(task)\n    save_task_runtime(root, task)\n\n\ndef mark_subagent_pid(root: Path, task: TaskRecord, subagent_id: str, pid: int | None) -> None:\n    state = _runtime_subagent_state(task, subagent_id)\n    if pid is None or state is None or state.pid == pid:\n        return\n    now = utcnow()\n    task.runtime.updated_at = now\n    _upsert_runtime_subagent_state(\n        task,\n        state.model_copy(update={\"pid\": pid, \"updated_at\": now}),\n    )\n    _refresh_runtime_subagent_views(task)\n    save_task_runtime(root, task)\n\n\ndef mark_subagent_progress(\n    root: Path,\n    task: TaskRecord,\n    *,\n    subagent_id: str,\n    pid: int | None = None,\n    transcript: str | None = None,\n    continuation: RuntimeEngineContinuation | None = None,\n) -> None:\n    state = _runtime_subagent_state(task, subagent_id)\n    if state is None:\n        return\n    now = utcnow()\n    task.runtime.updated_at = now\n    if task.runtime.current_stage.step is not None:\n        task.runtime.current_stage = task.runtime.current_stage.model_copy(update={\"updated_at\": now})\n    updates: dict[str, object] = {\"updated_at\": now}\n    if pid is not None:\n        updates[\"pid\"] = pid\n    if transcript is not None:\n        updates[\"transcript_snippet\"] = summarize_transcript(transcript)\n    if continuation is not None:\n        updates[\"continuation\"] = continuation\n    _upsert_runtime_subagent_state(task, state.model_copy(update=updates))\n    _refresh_runtime_subagent_views(task)\n    save_task_runtime(root, task)\n\n\ndef mark_subagent_finished(\n    root: Path,\n    task: TaskRecord,\n    ref: SubagentRef,\n    transcript: str,\n    exit_code: int,\n    pid: int | None = None,\n    interruption_reason: str | None = None,\n    resource_limit_event: ResourceLimitEvent | None = None,\n    continuation: RuntimeEngineContinuation | None = None,\n) -> None:\n    now = utcnow()\n    state = _runtime_subagent_state(task, ref.id)\n    started_at = state.started_at if state is not None else now\n    runtime_pid = pid\n    if runtime_pid is None and state is not None:\n        runtime_pid = state.pid\n    task.runtime.updated_at = now\n    _upsert_runtime_subagent_state(\n        task,\n        RuntimeSubagentState(\n            id=ref.id,\n            role=ref.role,\n            engine=ref.engine,\n            status=ref.status,\n            path=ref.path,\n            worker_key=ref.worker_key,\n            assignment=ref.assignment,\n            pid=runtime_pid,\n            sandboxed=ref.sandboxed,\n            sandbox_summary=ref.sandbox_summary,\n            started_at=started_at,\n            updated_at=now,\n            completed_at=now,\n            exit_code=exit_code,\n            transcript_snippet=summarize_transcript(transcript),\n            interruption_reason=interruption_reason or \"\",\n            resource_limit_event=resource_limit_event,\n            continuation=(\n                continuation\n                if continuation is not None\n                else state.continuation\n                if state is not None\n                else None\n            ),\n        ),\n    )\n    _refresh_runtime_subagent_views(task)\n    save_task_runtime(root, task)\n\n\ndef mark_engine_switch(\n    root: Path,\n    task: TaskRecord,\n    *,\n    step: str,\n","exit_code":0,"status":"completed"}}
