nistic assignment: {assignment}\\n\"\n+        \"- Scope: implement only this assignment from the task plan while other SWE workers may be active.\\n\"\n+        \"- Reporting: summarize only your slice, including the files you changed and tests you ran.\\n\"\n+    )\n+\n+\n+def _aggregate_parallel_reports(\n+    task: TaskRecord,\n+    step: str,\n+    worker_reports: list[tuple[dict[str, str], StageReport]],\n+) -> StageReport:\n+    overall_verdict = min(\n+        (report.verdict for _, report in worker_reports),\n+        key=lambda verdict: _PARALLEL_VERDICT_ORDER[verdict],\n+    )\n+    if overall_verdict in {\"pass\", \"accept\"}:\n+        summary = f\"{step} fanout completed across {len(worker_reports)} workers\"\n+    else:\n+        failed = [\n+            f\"{spec['worker_key']}={report.verdict}\"\n+            for spec, report in worker_reports\n+            if report.verdict not in {\"pass\", \"accept\"}\n+        ]\n+        summary = f\"{step} fanout incomplete: {'; '.join(failed)}\"\n+\n+    feedback_parts: list[str] = []\n+    warnings: list[str] = []\n+    files_changed: list[str] = []\n+    follow_up_tasks = []\n+    tests = {\"added\": 0, \"passing\": 0}\n+    resource_limit_event = None\n+\n+    for spec, report in worker_reports:\n+        files_changed.extend(report.files_changed)\n+        follow_up_tasks.extend(report.follow_up_tasks)\n+        tests[\"added\"] += int(report.tests.get(\"added\", 0))\n+        tests[\"passing\"] += int(report.tests.get(\"passing\", 0))\n+        warnings.extend(\n+            f\"{spec['worker_key']}: {warning}\" for warning in report.warnings\n+        )\n+        if resource_limit_event is None and report.resource_limit_event is not None:\n+            resource_limit_event = report.resource_limit_event\n+        feedback_parts.append(\n+            \"\\n\".join(\n+                [\n+                    f\"[{spec['worker_key']}] {report.verdict}: {report.summary}\",\n+                    f\"assignment: {spec['assignment']}\",\n+                    report.feedback.strip(),\n+                ]\n+            ).strip()\n+        )\n+\n+    return StageReport(\n+        task_id=task.id,\n+        step=step,  # type: ignore[arg-type]\n+        verdict=overall_verdict,  # type: ignore[arg-type]\n+        summary=summary,\n+        feedback=\"\\n\\n\".join(part for part in feedback_parts if part).strip(),\n+        files_changed=sorted(set(files_changed)),\n+        follow_up_tasks=follow_up_tasks,\n+        tests=tests,\n+        warnings=warnings,\n+        resource_limit_event=resource_limit_event,\n+    )\n \n \n def resolve_next_task(root: Path) -> TaskRecord | None:\n@@ -1438,6 +1531,7 @@ def build_executor(\n         execution_events: list[str] = []\n         engines = _engine_attempt_order(next_stage_engine_names, config.engine_fallbacks)\n         limit_trigger_reason: str | None = None\n+        worker_specs = _implementing_worker_specs(current_task) if step == \"implementing\" else []\n \n         for index, engine_name in enumerate(engines):\n             budget_reason = budget_ledger.block_reason(engine_name)\n@@ -1471,6 +1565,89 @@ def build_executor(\n \n             budget_ledger.record(engine_name)\n             model_name = resolve_model(task, config, engine_name=engine_name, model_override=model_override)\n+            if worker_specs:\n+                role_name = _role_for_step(step, current_task)\n+                base_prompt = stage_prompt(\n+                    current_task,\n+                    step,\n+                    workspace_context=workspace_context,\n+                    process_profile=config.process_profile,\n+                    role_name=role_name,\n+                    config=config,\n+                    root=root,\n+                )\n+                worker_results: list[tuple[dict[str, str], object]] = []\n+                with ThreadPoolExecutor(max_workers=len(worker_specs)) as pool:\n+                    futures = [\n+         