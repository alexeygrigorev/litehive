ate a parent-shell VIRTUAL_ENV and assert\n  the child env/logs use the target workspace without uv mismatch warnings.\n- Run the narrow affected pytest selection first, then any broader smoke command needed\n  to prove the fix did not break normal workspace execution.\nhuman_checkpoints: []\nsubagents: []\ngit:\n  auto_commit: true\n  commit_message: 'litehive: complete T-0279 isolate-workspace-execution-from-inherited'\n  commit_sha: null\n  checkpoint_base_sha: null\n  checkpoint_attempts: 0\n  rolled_back_checkpoint_attempt: null\n  merge_agent_attempts: 0\n  worktree_path: null\nretry_policy:\n  max_retries: null\n  stage_retry_limit: null\ncreated_from: null\nupstream_origin: null\ngithub_origin: null\n","exit_code":0,"status":"completed"}}
